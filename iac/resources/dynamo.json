{
  "dynamo": [
    {
      "name": "monkey-euc1-dynamo-outbox-pattern",
      "hash-key-name": "id",
      "range-key-name": "created_at",
      "billing-mode": "PAY_PER_REQUEST",
      "stream-enabled": true,
      "stream-view-type": "NEW_AND_OLD_IMAGES",
      "attributes": [
        {
          "name": "id",
          "type": "S"
        },
        {
          "name": "created_at",
          "type": "S"
        },
        {
          "name": "subject",
          "type": "S"
        }
      ],
      "global-secondary-indexes": [
        {
          "name": "monkey-euc1-dynamo-outbox-pattern-subject-index",
          "type": "S",
          "hash-key": "subject",
          "projection-type": "ALL"
        }
      ]
    }
  ],
  "tags" : {
    "owner": "amundaray24",
    "project": "monkey-architecture",
    "contact": "https://github.com/amundaray24"
